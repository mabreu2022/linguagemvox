{
  "name": "vox-lang",
  "version": "1.1.0",
  "description": "Vox — A modern object-oriented programming language with native compilation and real-time concurrency",
  "main": "dist/index.js",
  "bin": {
    "vox": "./dist/cli/index.js",
    "kael": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/codegen', {recursive:true}); fs.copyFileSync('src/codegen/vox_runtime.h', 'dist/codegen/vox_runtime.h'); fs.mkdirSync('dist/runtime', {recursive:true}); fs.copyFileSync('src/runtime/db_worker.js', 'dist/runtime/db_worker.js');\"",
    "dev": "tsc --watch",
    "test": "npx jest",
    "vox": "npx ts-node src/cli/index.ts",
    "kael": "npx ts-node src/cli/index.ts",
    "crud:web": "node clientes/server.js",
    "clientes:web": "node clientes/server.js",
    "crud:mvc": "node dist/cli/index.js run clientes/app.vox",
    "crud:manual": "powershell -Command Start-Process clientes/manual.html",
    "livro": "powershell -Command Start-Process docs/livro_vox.html",
    "livro:build": "node tools/build_book.js"
  },
  "keywords": [
    "compiler",
    "programming-language",
    "oop"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "dependencies": {
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "node-firebird": "^2.16.0"
  }
}
