/* 8 Alças de Redimensionamento (Handles) Clássicas */
.delphi-handle {
  position: absolute;
  width: 6px;
  height: 6px;
  background: #0078d4;
  border: 1px solid #ffffff;
  display: none;
  pointer-events: auto !important;
  z-index: 250;
  box-sizing: border-box;
}

.delphi-comp.selected .delphi-handle {
  display: block;
}

.dh-nw { top: -3px; left: -3px; cursor: nwse-resize; }
.dh-n  { top: -3px; left: calc(50% - 3px); cursor: ns-resize; }
.dh-ne { top: -3px; right: -3px; cursor: nesw-resize; }
.dh-e  { top: calc(50% - 3px); right: -3px; cursor: ew-resize; }
.dh-se { bottom: -3px; right: -3px; cursor: nwse-resize; }
.dh-s  { bottom: -3px; left: calc(50% - 3px); cursor: ns-resize; }
.dh-sw { bottom: -3px; left: -3px; cursor: nesw-resize; }
.dh-w  { top: calc(50% - 3px); left: -3px; cursor: ew-resize; }

/* ============================================================================
   COMPONENTES NÃO-VISUAIS NO FORM DESIGNER (DELPHI RAD STUDIO STYLE)
   ============================================================================ */
.delphi-comp.delphi-nonvisual-comp {
  min-width: 44px;
  min-height: 44px;
}

/* Esconde as 4 alças centrais que cortam o ícone e a etiqueta do componente */
.delphi-comp.delphi-nonvisual-comp > .delphi-comp-handles > .delphi-handle.dh-n,
.delphi-comp.delphi-nonvisual-comp > .delphi-comp-handles > .delphi-handle.dh-s,
.delphi-comp.delphi-nonvisual-comp > .delphi-comp-handles > .delphi-handle.dh-w,
.delphi-comp.delphi-nonvisual-comp > .delphi-comp-handles > .delphi-handle.dh-e {
  display: none !important;
}

/* Container do componente não-visual: Perfeitamente centralizado */
.vcl-non-visual {
  width: 100% !important;
  height: 100% !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  text-align: center !important;
  position: relative !important;
  padding: 0 !important;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.6);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  transition: all 0.15s ease;
  overflow: visible;
}

body.theme-dark .vcl-non-visual {
  background: rgba(30, 41, 59, 0.85);
  border-color: rgba(148, 163, 184, 0.4);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
}

.delphi-comp:hover .vcl-non-visual {
