/* ==============================================================================
   VOX STUDIO — Delphi RAD Studio Theme & Layout
   Replicação visual fiel do Delphi 11/12 Alexandria/Athens
   ============================================================================== */

:root {
  /* Delphi RAD Studio Dark Theme Palette */
  --delphi-bg-darkest: #16191f;
  --delphi-bg-dark: #1e2229;
  --delphi-bg-panel: #232832;
  --delphi-bg-panel-hover: #2b323e;
  --delphi-bg-input: #181b22;
  --delphi-bg-active: #2f3644;
  --delphi-bg-selection: #094771;

  --delphi-border-dark: #181b20;
  --delphi-border-light: #313947;
  --delphi-border-focus: #0078d4;

  --delphi-blue: #0098ff;
  --delphi-blue-dark: #0078d4;
  --delphi-blue-light: #4cc2ff;
  --delphi-green: #107c41;
  --delphi-green-bright: #22c55e;
  --delphi-red: #d13438;
  --delphi-orange: #d83b01;

  --delphi-text: #e6ebf2;
  --delphi-text-muted: #9aa7b8;
  --delphi-text-dim: #6c7889;

  --font-ui: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', Roboto, sans-serif;
  --font-code: 'Consolas', 'JetBrains Mono', 'Fira Code', monospace;

  /* Delphi Form Canvas (Classic light gray form inside dark workspace) */
  --delphi-form-bg: #f0f2f5;
  --delphi-form-text: #1a1a1a;
  --delphi-form-border: #a0a8b4;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
}

body {
  font-family: var(--font-ui);
  font-size: 12px;
  background-color: var(--delphi-bg-darkest);
  color: var(--delphi-text);
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ============================================================================
   1. MENU BAR & TOOLBAR (PADRÃO DELPHI RAD STUDIO)
   ============================================================================ */
.delphi-menubar {
  height: 26px;
  background-color: var(--delphi-bg-darkest);
  display: flex;
  align-items: center;
  padding: 0 6px;
  border-bottom: 1px solid var(--delphi-border-dark);
  font-size: 11.5px;
}

.delphi-menu-item {
  padding: 3px 8px;
  color: var(--delphi-text);
  cursor: pointer;
  border-radius: 2px;
  transition: background 0.1s ease;
}

.delphi-menu-item:hover {
  background: var(--delphi-bg-panel-hover);
  color: #ffffff;
}

/* Barra de Ferramentas / Toolstrip */
.delphi-toolbar {
  height: 38px;
  background: var(--delphi-bg-dark);
  border-bottom: 1px solid var(--delphi-border-dark);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  gap: 8px;
}

.toolbar-group {
  display: flex;
  align-items: center;
  gap: 3px;
}

.tool-sep {
  width: 1px;
  height: 20px;
  background-color: var(--delphi-border-light);
  margin: 0 4px;
}

.tool-btn {
  height: 28px;
  min-width: 28px;
  padding: 0 6px;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  color: var(--delphi-text);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  cursor: pointer;
  font-size: 12px;
  transition: all 0.1s ease;
}

.tool-btn:hover {
  background: var(--delphi-bg-panel);
  border-color: var(--delphi-border-light);
}

.tool-btn.btn-run-delphi {
  color: var(--delphi-green-bright);
  font-weight: 700;
}

.tool-btn.btn-run-delphi:hover {
  background: rgba(34, 197, 94, 0.15);
  border-color: var(--delphi-green-bright);
}

.platform-dropdown {
  background: var(--delphi-bg-input);
  color: var(--delphi-text);
  border: 1px solid var(--delphi-border-light);
  height: 26px;
  padding: 0 8px;
  border-radius: 3px;
  font-size: 11px;
  font-family: var(--font-ui);
  outline: none;
  cursor: pointer;
}

.platform-dropdown:focus {
  border-color: var(--delphi-blue);
}

/* ============================================================================
   2. LAYOUT PRINCIPAL (3 COLUNAS: ESQUERDA, CENTRO, DIREITA)
   ============================================================================ */
.delphi-workspace {
  flex: 1;
  display: flex;
  overflow: hidden;
  position: relative;
}

/* Painéis com Cabeçalho Delphi (Dock Panels) */
.dock-panel {
  background: var(--delphi-bg-dark);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--delphi-border-dark);
}

.panel-header {
  height: 26px;
  background: var(--delphi-bg-panel);
  border-bottom: 1px solid var(--delphi-border-dark);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  font-size: 11px;
  font-weight: 600;
  color: var(--delphi-text);
}

.panel-header-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--delphi-text-dim);
  font-size: 11px;
}

.panel-header-actions span {
  cursor: pointer;
}

.panel-header-actions span:hover {
  color: var(--delphi-text);
}

/* ----------------------------------------------------------------------------
   COLUNA ESQUERDA: STRUCTURE (TOPO) + OBJECT INSPECTOR (FUNDO)
   ---------------------------------------------------------------------------- */
.left-dock-column {
  width: 280px;
  min-width: 180px;
  max-width: 800px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

/* Painel Structure */
.structure-panel {
  height: 200px;
  min-height: 80px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

.structure-toolbar {
  height: 24px;
  background: var(--delphi-bg-dark);
  border-bottom: 1px solid var(--delphi-border-dark);
  display: flex;
  align-items: center;
  padding: 0 6px;
  gap: 6px;
  font-size: 11px;
  color: var(--delphi-text-muted);
}

.structure-tree {
  flex: 1;
  overflow-y: auto;
  padding: 4px;
  font-size: 11.5px;
}

.tree-node {
  padding: 3px 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  border-radius: 2px;
  color: var(--delphi-text);
}

.tree-node:hover {
  background: var(--delphi-bg-panel-hover);
}

.tree-node.selected {
  background: var(--delphi-bg-selection);
  color: #ffffff;
}

.tree-node-icon {
  font-size: 11px;
  color: var(--delphi-blue-light);
}

/* Painel Object Inspector */
.object-inspector-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.oi-selector-container {
  padding: 4px 6px;
  background: var(--delphi-bg-dark);
  border-bottom: 1px solid var(--delphi-border-dark);
}

.oi-component-dropdown {
  width: 100%;
  background: var(--delphi-bg-input);
  color: var(--delphi-text);
  border: 1px solid var(--delphi-border-light);
  height: 24px;
  padding: 0 6px;
  border-radius: 2px;
  font-size: 11.5px;
  font-weight: 600;
  outline: none;
}

.oi-search-bar {
  padding: 3px 6px;
  background: var(--delphi-bg-dark);
  border-bottom: 1px solid var(--delphi-border-dark);
  display: flex;
  align-items: center;
}

.oi-search-input {
  width: 100%;
  background: var(--delphi-bg-input);
  border: 1px solid var(--delphi-border-light);
  color: var(--delphi-text);
  padding: 2px 6px;
  font-size: 11px;
  border-radius: 2px;
  outline: none;
}

.oi-tabs {
  height: 26px;
  display: flex;
  background: var(--delphi-bg-panel);
  border-bottom: 1px solid var(--delphi-border-dark);
}

.oi-tab {
  flex: 1;
  text-align: center;
  padding: 5px;
  font-size: 11px;
  font-weight: 600;
  color: var(--delphi-text-muted);
  cursor: pointer;
  border-bottom: 2px solid transparent;
}

.oi-tab:hover {
  color: #ffffff;
}

.oi-tab.active {
  color: var(--delphi-blue-light);
  border-bottom-color: var(--delphi-blue-light);
  background: var(--delphi-bg-dark);
}

.oi-grid-content {
  flex: 1;
  overflow-y: auto;
}

/* Grid de Propriedades Clássico do Delphi */
.delphi-prop-grid {
  width: 100%;
  border-collapse: collapse;
  font-size: 11.5px;
}

.delphi-prop-grid tr {
  border-bottom: 1px solid #282f3a;
  height: 22px;
}

.delphi-prop-grid tr:hover {
  background: rgba(255, 255, 255, 0.03);
}

.delphi-prop-grid td.prop-col-name {
  width: 45%;
  padding: 2px 6px;
  color: var(--delphi-text);
  border-right: 1px solid #282f3a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.delphi-prop-grid td.prop-col-val {
  padding: 1px 4px;
}

.delphi-prop-input {
  width: 100%;
  background: transparent;
  border: none;
  color: #ffffff;
  font-size: 11.5px;
  font-family: var(--font-ui);
  padding: 2px 4px;
  outline: none;
}

.delphi-prop-input:focus {
  background: var(--delphi-bg-input);
  outline: 1px solid var(--delphi-blue);
}

.oi-footer-links {
  height: 22px;
  background: var(--delphi-bg-panel);
  border-top: 1px solid var(--delphi-border-dark);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  font-size: 10.5px;
  color: var(--delphi-blue-light);
}

.oi-footer-links span {
  cursor: pointer;
}

.oi-footer-links span:hover {
  text-decoration: underline;
}

/* ----------------------------------------------------------------------------
   COLUNA CENTRAL: DESIGNER CANVAS & CODE VIEW COM ABAS INFERIORES DELPHI
   ---------------------------------------------------------------------------- */
.center-dock-column {
  flex: 1;
  min-width: 200px;
  display: flex;
  flex-direction: column;
  background: #252a34;
  position: relative;
  overflow: hidden;
}

/* ============================================================================
   DELPHI IDE DOCK SPLITTERS (REDIMENSIONAMENTO DOS PAINÉIS LATERAIS)
   ============================================================================ */
.dock-splitter {
  background: var(--delphi-bg-panel, #232832);
  position: relative;
  user-select: none;
  -webkit-user-select: none;
  flex-shrink: 0;
  transition: background-color 0.12s ease;
  z-index: 20;
}

.dock-splitter-h {
  height: 5px;
  width: 100%;
  cursor: ns-resize;
  border-top: 1px solid var(--delphi-border-dark, #181b20);
  border-bottom: 1px solid var(--delphi-border-dark, #181b20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dock-splitter-v {
  width: 5px;
  height: 100%;
  cursor: ew-resize;
  border-left: 1px solid var(--delphi-border-dark, #181b20);
  border-right: 1px solid var(--delphi-border-dark, #181b20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dock-splitter:hover,
.dock-splitter.dragging {
  background: var(--delphi-blue, #0098ff) !important;
  border-color: var(--delphi-blue-dark, #0078d4) !important;
}

.splitter-grip-h {
  width: 24px;
  height: 1px;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 1px;
  pointer-events: none;
}

.splitter-grip-v {
  width: 1px;
  height: 24px;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 1px;
  pointer-events: none;
}

.dock-splitter:hover .splitter-grip-h,
.dock-splitter:hover .splitter-grip-v,
.dock-splitter.dragging .splitter-grip-h,
.dock-splitter.dragging .splitter-grip-v {
  background: #ffffff;
}

body.theme-light .splitter-grip-h,
body.theme-light .splitter-grip-v {
  background: rgba(0, 0, 0, 0.25);
}

body.theme-light .dock-splitter:hover .splitter-grip-h,
body.theme-light .dock-splitter:hover .splitter-grip-v,
body.theme-light .dock-splitter.dragging .splitter-grip-h,
body.theme-light .dock-splitter.dragging .splitter-grip-v {
  background: #ffffff;
}

/* Estado de redimensionamento global */
body.dock-resizing {
  user-select: none !important;
  -webkit-user-select: none !important;
}

body.dock-resizing iframe,
body.dock-resizing canvas,
body.dock-resizing input,
body.dock-resizing select,
body.dock-resizing textarea {
  pointer-events: none !important;
}

body.dock-resizing-v {
  cursor: ew-resize !important;
}

body.dock-resizing-h {
  cursor: ns-resize !important;
}

/* Aba superior do Documento: Multi-Tabs Delphi Style */
.document-tab-bar {
  height: 28px;
  background: var(--delphi-bg-darkest);
  display: flex;
  align-items: flex-end;
  border-bottom: 1px solid var(--delphi-border-dark);
  padding: 0 4px;
  overflow-x: auto;
  overflow-y: hidden;
  gap: 2px;
}
.document-tab-bar::-webkit-scrollbar {
  height: 2px;
}
.document-tab-bar::-webkit-scrollbar-thumb {
  background: #334155;
}

.doc-tab {
  height: 26px;
  background: #161a22;
  border: 1px solid var(--delphi-border-dark);
  border-bottom: none;
  border-top: 2px solid transparent;
  color: #94a3b8;
  padding: 0 10px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  user-select: none;
  transition: all 0.12s ease;
}

.doc-tab:hover {
  background: #1e2430;
  color: #f1f5f9;
}

.doc-tab.active {
  background: var(--delphi-bg-dark);
  border-color: var(--delphi-border-dark);
  border-top: 2px solid var(--delphi-blue);
  color: #ffffff;
  font-weight: 600;
}

.doc-tab-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: transparent;
  display: none;
}

.doc-tab.dirty .doc-tab-dot {
  display: inline-block;
  background: #f59e0b;
  box-shadow: 0 0 5px rgba(245, 158, 11, 0.6);
}

.doc-tab-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  font-size: 10px;
  color: #64748b;
  border-radius: 2px;
  margin-left: 2px;
  transition: all 0.15s ease;
}

.doc-tab-close:hover {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

/* Área do Designer */
.delphi-designer-container {
  flex: 1;
  overflow: auto;
  position: relative;
  background-color: #242933;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 40px;
}

/* A Janela Form do Delphi */
.delphi-form-window {
  position: absolute;
  top: 30px;
  left: 40px;
  width: 700px;
  height: 480px;
  min-width: 200px;
  min-height: 140px;
  background: var(--delphi-form-bg);
  border: 1px solid #738096;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
}

/* Moldura e Alças de Redimensionamento do Form (Padrão Exato do Delphi) */
.form-resize-bar-r {
  position: absolute;
  right: -10px;
  top: 0;
  width: 14px;
  height: 100%;
  border-right: 2.5px solid #5b9bd5;
  cursor: ew-resize;
  z-index: 240;
  user-select: none;
}

.form-resize-bar-b {
  position: absolute;
  left: 0;
  bottom: -10px;
  width: 100%;
  height: 14px;
  border-bottom: 2.5px solid #5b9bd5;
  cursor: ns-resize;
  z-index: 240;
  user-select: none;
}

.form-handle-r {
  position: absolute;
  right: -13px;
  top: calc(50% - 6px);
  width: 12px;
  height: 12px;
  background: #79aee5;
  border: 1.5px solid #1c4b78;
  cursor: ew-resize;
  z-index: 250;
  user-select: none;
  box-sizing: border-box;
}

.form-handle-r::before,
.form-handle-b::before,
.form-handle-br::before {
  content: '';
  position: absolute;
  top: -8px;
  left: -8px;
  right: -8px;
  bottom: -8px;
}

.form-handle-b {
  position: absolute;
  bottom: -13px;
  left: calc(50% - 6px);
  width: 12px;
  height: 12px;
  background: #79aee5;
  border: 1.5px solid #1c4b78;
  cursor: ns-resize;
  z-index: 250;
  user-select: none;
  box-sizing: border-box;
}

.form-handle-br {
  position: absolute;
  bottom: -13px;
  right: -13px;
  width: 12px;
  height: 12px;
  background: #79aee5;
  border: 1.5px solid #1c4b78;
  cursor: nwse-resize;
  z-index: 250;
  user-select: none;
  box-sizing: border-box;
}

.form-handle-r:hover, .form-handle-b:hover, .form-handle-br:hover {
  background: #a8d2ff;
  border-color: #002244;
  outline: 1.5px solid #ffffff;
}

.delphi-form-titlebar {
  height: 28px;
  background: #ffffff;
  border-bottom: 1px solid #d0d7de;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  cursor: move;
  color: #1a1a1a;
  font-size: 12px;
  font-weight: 500;
}

.delphi-form-icon {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #d83b01;
  display: inline-block;
  margin-right: 6px;
}

.delphi-form-title {
  display: flex;
  align-items: center;
}

.delphi-form-sysbuttons {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  color: #555555;
}

/* O Canvas com Grid de Pontos Clássico do Delphi */
.delphi-form-canvas {
  position: relative;
  flex: 1 1 auto;
  width: 100%;
  min-height: 100px;
  background-color: #f4f6f8;
  background-image: radial-gradient(#6b7280 1.2px, transparent 1.2px);
  background-size: 8px 8px;
  overflow: hidden;
}

/* Componentes em cima do Form */
.delphi-comp {
  position: absolute;
  cursor: move;
  box-sizing: border-box;
  user-select: none;
  -webkit-user-select: none;
  pointer-events: auto !important;
}

.delphi-comp.selected {
  outline: 1.5px solid var(--delphi-blue) !important;
  z-index: 100;
}

/* Camada visual do componente */
.delphi-comp-visual {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  box-sizing: border-box;
  user-select: none;
  -webkit-user-select: none;
}

/* Camada de filhos para contêineres */
.delphi-comp-children {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  box-sizing: border-box;
}

.delphi-comp-children > .delphi-comp {
  pointer-events: auto;
}

.delphi-comp-handles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 200;
}

/* Delphi VCL Panel */
.vcl-panel {
  width: 100% !important;
  height: 100% !important;
  border: 1px solid #738096;
  border-radius: 2px;
  position: relative;
  box-sizing: border-box;
  background: #e9ecef;
  box-shadow: inset 1px 1px 0 #ffffff, inset -1px -1px 0 #738096;
  user-select: none;
  -webkit-user-select: none;
}

.vcl-panel-caption {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  font-size: 11px;
  color: #64748b;
  font-weight: 500;
  user-select: none;
  -webkit-user-select: none;
  pointer-events: none;
  padding: 4px 10px;
}

.vcl-panel-caption.text-left {
  justify-content: flex-start;
}

.vcl-panel-caption.text-right {
  justify-content: flex-end;
}

.vcl-panel-caption.text-center {
  justify-content: center;
}

body:not(.theme-light) .vcl-panel {
  background: #1e2430;
  border-color: #3b4554;
  box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.05), inset -1px -1px 0 rgba(0, 0, 0, 0.4);
}

body:not(.theme-light) .vcl-panel-caption {
  color: #94a3b8;
}

/* Delphi VCL PageControl & TabSheet Container */
.delphi-comp.delphi-pagecontrol-comp > .delphi-comp-children {
  position: absolute;
  top: 26px;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: calc(100% - 26px);
  pointer-events: none;
  box-sizing: border-box;
}

.delphi-comp.delphi-pagecontrol-comp.tab-pos-tpbottom > .delphi-comp-children {
  top: 0;
  bottom: 26px;
  height: calc(100% - 26px);
}

.delphi-comp.delphi-tabsheet-comp {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  box-sizing: border-box;
}

.delphi-comp.delphi-tabsheet-comp > .delphi-comp-children {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  box-sizing: border-box;
}

.delphi-comp.delphi-tabsheet-comp > .delphi-comp-handles > .delphi-handle {
  display: none !important;
}

.delphi-comp.delphi-tabsheet-comp.selected {
  outline: 1.5px dashed var(--delphi-blue) !important;
}

/* Visual do PageControl */
.vcl-pagecontrol {
  width: 100% !important;
  height: 100% !important;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
  user-select: none;
  -webkit-user-select: none;
}

