/* ==========================================================================
   SISTEMA DE DEPURAÇÃO DELPHI — GUTTER, BREAKPOINTS, EXECUTION E DEBUG DOCK
   ========================================================================== */

/* 1. Calha do Editor (Gutter / Line Numbers) */
.line-numbers {
  width: 58px !important;
  background: #14171d !important;
  border-right: 1px solid #282f3a !important;
  user-select: none;
  overflow: hidden;
  padding: 12px 0 !important;
  box-sizing: border-box;
}

.gutter-line {
  height: 22px;
  line-height: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 0 6px;
  cursor: pointer;
  transition: background 0.1s ease;
}

.gutter-line:hover {
  background: rgba(255, 255, 255, 0.06);
}

.gutter-bp-slot {
  width: 20px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
}

.gutter-line:hover .gutter-bp-slot:empty::after {
  content: '●';
  color: rgba(239, 68, 68, 0.5);
  font-size: 11px;
}

.gutter-line-num {
  color: #5a6578;
  font-family: 'JetBrains Mono', Consolas, monospace;
  font-size: 11.5px;
  text-align: right;
  min-width: 22px;
  padding-right: 2px;
}

.gutter-line.has-bp .gutter-line-num {
  color: #ef4444;
  font-weight: 700;
}

.gutter-line.has-exec .gutter-line-num {
  color: #38bdf8;
  font-weight: 700;
}

.bp-dot-icon {
  font-size: 11px;
  filter: drop-shadow(0 0 4px rgba(239, 68, 68, 0.8));
  animation: bpAppear 0.2s ease-out;
}

.exec-arrow-icon {
  font-size: 12px;
  filter: drop-shadow(0 0 5px rgba(56, 189, 248, 0.9));
  animation: execPulse 1.5s infinite alternate;
}

@keyframes bpAppear {
  from { transform: scale(0.4); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes execPulse {
  0% { transform: translateX(0); }
  100% { transform: translateX(3px); }
}

/* 2. Camada de Realce de Linhas de Código (Highlight Layer) */
.code-highlight-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  padding: 12px 0;
  overflow: hidden;
  z-index: 1;
}

.code-hl-line {
  height: 22px;
  line-height: 22px;
  width: 100%;
  box-sizing: border-box;
}

.code-hl-line.bp-line {
  background: rgba(220, 38, 38, 0.22);
  border-left: 3px solid #ef4444;
}

.code-hl-line.exec-line {
  background: rgba(14, 165, 233, 0.32);
  border-left: 3px solid #38bdf8;
  box-shadow: inset 0 0 12px rgba(56, 189, 248, 0.25);
  animation: execGlow 2s infinite ease-in-out;
}

.code-hl-line.bp-exec-line {
  background: linear-gradient(90deg, rgba(220, 38, 38, 0.35) 0%, rgba(14, 165, 233, 0.3) 100%);
  border-left: 4px solid #f59e0b;
}

@keyframes execGlow {
  0%, 100% { opacity: 0.9; }
  50% { opacity: 1; background: rgba(14, 165, 233, 0.42); }
}

/* 3. Tooltip de Inspeção Rápida (Evaluate Tooltip) */
.delphi-evaluate-tooltip {
  position: fixed;
  z-index: 9999;
  background: #181d26;
  border: 1px solid #0078d4;
  border-radius: 4px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.6);
  padding: 6px 12px;
  font-family: 'JetBrains Mono', Consolas, monospace;
  font-size: 11.5px;
  line-height: 1.4;
  pointer-events: none;
}

/* 4. Dock Inferior de Depuração (Delphi Debug Dock) */
#delphiDebugDock {
  height: 200px;
  background: #16191f;
  border-top: 1px solid #282f3a;
  display: none;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  z-index: 100;
  box-shadow: 0 -4px 14px rgba(0,0,0,0.3);
}

#delphiDebugDock.collapsed {
  height: 28px !important;
}

.debug-dock-header {
  height: 28px;
  background: #1f242d;
  border-bottom: 1px solid #282f3a;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  user-select: none;
}

.debug-dock-tabs {
  display: flex;
  height: 100%;
}

.debug-dock-tab {
  padding: 0 12px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  color: #94a3b8;
  cursor: pointer;
  border-right: 1px solid #282f3a;
  border-top: 2px solid transparent;
  transition: all 0.15s;
}

.debug-dock-tab:hover {
  color: #ffffff;
  background: #252b36;
}

.debug-dock-tab.active {
  background: #16191f;
  color: #38bdf8;
  border-top: 2px solid #0078d4;
  font-weight: 600;
}

.debug-dock-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: #94a3b8;
}

.debug-dock-body {
  flex: 1;
  overflow: auto;
  position: relative;
  background: #12151b;
}

.debug-dock-page {
  display: none;
  height: 100%;
}

/* Tabelas do Dock */
.debug-table {
