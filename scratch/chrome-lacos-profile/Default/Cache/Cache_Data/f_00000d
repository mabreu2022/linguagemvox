        mainForm: 'Form1',
        units: ['Form1.vox', 'Form1.vxf']
      },
      pdv: {
        name: 'PDV_FrenteDeCaixa',
        file: 'projetos/PDV_FrenteDeCaixa/PDV_FrenteDeCaixa.dproj',
        folder: 'projetos/PDV_FrenteDeCaixa',
        mainForm: 'Form1',
        units: ['pdv_controller.vox', 'pdv_model.vox', 'Form1.vox', 'Form1.vxf']
      },
