    };

    const formName = this.designer.form.name || 'Form1';
    this.currentProjectGroup = null;
    this.currentProject = tmplConfigs[templateKey] || {
      name: formName,
      file: `${formName}.dproj`,
      folder: '.',
      mainForm: formName,
      units: [`${formName}.vox`, `${formName}.vxf`]
    };

    const vxfName = `${formName}.vxf`;
