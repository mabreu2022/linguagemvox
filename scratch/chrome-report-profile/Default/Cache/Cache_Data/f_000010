<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vox Studio — RAD IDE</title>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/rad.css?v=3.7">
</head>
<body>

  <!-- ========================================================================
       1. MENU BAR SUPERIOR (DELPHI PADRÃO)
       ======================================================================== -->
  <div class="delphi-menubar">
    <!-- File Menu -->
    <!-- File Menu (Delphi Standard) -->
    <div class="delphi-menu-item" id="menuItemFile">
      <span>File</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" onclick="window.app.newForm()"><span>📄 Novo Formulário (New Form)</span><span class="shortcut">Ctrl+N</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.newUnit()"><span>📝 Nova Unit / Código Fonte...</span><span class="shortcut">Ctrl+Shift+N</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openNewClassModal()"><span>🏛️ Nova Classe / Unit...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openCreateFromExampleModal()"><span>📦 Novo Projeto a partir de Exemplo...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.newProject()"><span>📦 Novo Projeto em Branco</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openFileDialog()"><span>📂 Abrir Arquivo (Unit, Classe, Form)...</span><span class="shortcut">Ctrl+O</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openProjectDialog()"><span>📁 Abrir Projeto... (.dproj / .vproj / .dpr)</span><span class="shortcut">Ctrl+Shift+O</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openProjectGroupDialog()"><span>📦 Abrir Grupo de Projetos... (.groupproj / .vpg)</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.saveForm()"><span>💾 Salvar (Save)</span><span class="shortcut">Ctrl+S</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openSaveDialog()"><span>💾 Salvar Como... (Save As)</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openSaveProjectAsModal()"><span>📁💾 Salvar Projeto Como...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.saveAll()"><span>📁💾 Salvar Tudo (Save All)</span><span class="shortcut">Ctrl+Shift+S</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.closeActiveFile()"><span>❌ Fechar Arquivo / Aba</span><span class="shortcut">Ctrl+F4</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.closeAllFiles()"><span>❌ Fechar Todos os Arquivos (Close All)</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.closeCurrentProject()"><span>🚪 Fechar Projeto</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.closeProjectGroup()"><span>📦❌ Fechar Grupo de Projetos</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.exitApp()"><span>🚪 Sair do Vox Studio (Exit)</span><span class="shortcut">Alt+F4</span></div>
      </div>
    </div>

    <!-- Edit Menu -->
    <div class="delphi-menu-item">
      <span>Edit</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" onclick="window.app.editUndo()"><span>↩️ Desfazer (Undo)</span><span class="shortcut">Ctrl+Z</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.editRedo()"><span>↪️ Refazer (Redo)</span><span class="shortcut">Ctrl+Y</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.editCut()"><span>✂️ Recortar</span><span class="shortcut">Ctrl+X</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.editCopy()"><span>📄 Copiar</span><span class="shortcut">Ctrl+C</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.editPaste()"><span>📋 Colar</span><span class="shortcut">Ctrl+V</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.designer.duplicateSelected()"><span>📑 Duplicar</span><span class="shortcut">Ctrl+D</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.designer.deleteSelected()"><span>🗑️ Excluir</span><span class="shortcut">Del</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.selectAll()"><span>☑️ Selecionar Tudo</span><span class="shortcut">Ctrl+A</span></div>
      </div>
    </div>

    <!-- Search Menu -->
    <div class="delphi-menu-item">
      <span>Search</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" onclick="window.app.openSearch()"><span>🔍 Localizar no Código...</span><span class="shortcut">Ctrl+F</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openReplace()"><span>🔄 Substituir no Código...</span><span class="shortcut">Ctrl+H</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.findNext()"><span>⬇️ Localizar Próximo</span><span class="shortcut">F3</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.findPrev()"><span>⬆️ Localizar Anterior</span><span class="shortcut">Shift+F3</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.gotoLine()"><span>🎯 Ir para a Linha...</span><span class="shortcut">Ctrl+G</span></div>
      </div>
    </div>

    <!-- View Menu -->
    <div class="delphi-menu-item">
      <span>View</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" onclick="window.app.toggleDesignCodeView()"><span>🔄 Alternar Design / Código</span><span class="shortcut">F12</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.switchView('designer')"><span>🎨 Visual Form Designer</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.switchView('code')"><span>📝 Editor de Código Vox</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.toggleTheme()"><span id="menuThemeIcon">☀️</span> <span id="menuThemeText">Modo Claro (Light Mode)</span></div>
      </div>
    </div>

    <!-- Refactor Menu -->
    <div class="delphi-menu-item">
      <span>Refactor</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" onclick="window.app.refactorRename()"><span>🏷️ Renomear Símbolo...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.refactorExtractFn()"><span>⚡ Extrair Função / Procedimento...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.refactorFormat()"><span>✨ Formatar Código Vox</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.refactorAddHandler()"><span>➕ Adicionar Manipulador de Evento...</span></div>
      </div>
    </div>

    <!-- Project Menu -->
    <div class="delphi-menu-item">
      <span>Project</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" onclick="window.app.openNewClassModal()"><span>🏛️ Nova Classe...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openCreateFromExampleModal()"><span>📦 Novo Projeto a partir de Exemplo...</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.buildWebApp()"><span>⚙️ Compilar Sistema Web</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.runApp()"><span>▶ Executar no Navegador</span><span class="shortcut">F9</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.switchView('code')"><span>💻 Ver Código do Projeto (.vox)</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.showProjectOptions()"><span>🔧 Opções do Projeto...</span></div>
      </div>
    </div>

    <!-- Run / Debug Menu (Delphi Standard) -->
    <div class="delphi-menu-item">
      <span>Run</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" onclick="window.app.runApp()"><span>▶ Executar Sem Depuração</span><span class="shortcut">Ctrl+F9</span></div>
        <div class="delphi-menu-dropdown-item" style="color: #22c55e; font-weight: 600;" onclick="window.app.startDebug()"><span>🐞 Iniciar com Depuração</span><span class="shortcut">F9</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.stepOver()"><span>⤵ Passo a Passo (Step Over)</span><span class="shortcut">F8</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.stepInto()"><span>⤷ Entrar na Função (Step Into)</span><span class="shortcut">F7</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.stepOut()"><span>⤴ Sair da Função (Step Out)</span><span class="shortcut">Shift+F8</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.runToCursor()"><span>🎯 Executar até o Cursor</span><span class="shortcut">F4</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.toggleBreakpointCurrentLine()"><span>🔴 Alternar Ponto de Parada</span><span class="shortcut">F5</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.clearAllBreakpoints()"><span>⚪ Limpar Todos os Breakpoints</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.pauseDebug()"><span>⏸ Pausar Depuração</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.stopDebug()"><span>⏹ Resetar Programa (Program Reset)</span><span class="shortcut">Ctrl+F2</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openAddWatchModal()"><span>👁️ Adicionar Watch...</span><span class="shortcut">Ctrl+F5</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.toggleDebugPanel()"><span>🗔 Exibir/Ocultar Painel de Depuração</span></div>
      </div>
    </div>

    <!-- Component Menu (Com a Fábrica de Componentes) -->
    <div class="delphi-menu-item">
      <span>Component</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" style="color: #ffca28; font-weight:600;" onclick="window.app.openComponentFactory()"><span>🏭 Fábrica de Componentes...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openInstallPackageModal()"><span>📦 Instalar Pacote de Componentes (.vdpk)...</span></div>
        <div class="delphi-menu-dropdown-item" style="color: #38bdf8;" onclick="window.app.openComponentBook()"><span>📖 Livro: Guia de Construção de Componentes...</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.initPalette()"><span>🔄 Recarregar Paleta de Ferramentas</span></div>
      </div>
    </div>

    <!-- Tools Menu -->
    <div class="delphi-menu-item">
      <span>Tools</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" onclick="window.app.openConnectionEditor(null)"><span>🔌 FireDAC Connection Editor...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openSqlEditor(null)"><span>📝 SQL Command Editor</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openExternalBrowser()"><span>🌐 Abrir Aplicação Web (Porta 5000)</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.runBackend()"><span>⚡ Executar via CLI Vox</span></div>
      </div>
    </div>

    <!-- Git Menu -->
    <div class="delphi-menu-item">
      <span>Git</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" style="color:#c084fc; font-weight:700;" onclick="window.app.openGitDialog('commit')"><span>🐙 Enviar para o GitHub (Commit & Push)...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.gitPull()"><span>📥 Atualizar do GitHub (Pull)</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openGitDialog('settings')"><span>⚙️ Configurar Repositório e Token GitHub...</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openGitDialog('log')"><span>📋 Ver Status e Terminal Git...</span></div>
      </div>
    </div>

    <!-- Help Menu -->
    <div class="delphi-menu-item">
      <span>Help</span>
      <div class="delphi-menu-dropdown">
        <div class="delphi-menu-dropdown-item" style="color:#38bdf8;" onclick="window.app.openHelpDoc('language_spec')"><span>📘 Manual da Linguagem Vox (Language Spec)</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openHelpDoc('tutorial')"><span>📗 Tutorial / Livro para Iniciantes</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openHelpDoc('manual_clientes')"><span>📙 Manual do Sistema de Clientes</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openComponentBook()"><span>📖 Manual de Construção de Componentes Vox</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openHelpDoc('livro_componentes')"><span>📕 Livro de Componentes (HTML)</span></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.openHelpDoc('livro_vox')"><span>📓 Livro Vox Completo (HTML)</span></div>
        <div class="menu-sep"></div>
        <div class="delphi-menu-dropdown-item" onclick="window.app.showAbout()"><span>ℹ️ Sobre o Vox Studio RAD</span></div>
      </div>
    </div>
  </div>

  <!-- ========================================================================
       2. TOOLBAR (BARRA DE FERRAMENTAS COM ÍCONES DELPHI)
       ======================================================================== -->
  <div class="delphi-toolbar">
    <div class="toolbar-group">
      <!-- Arquivo -->
      <button class="tool-btn" onclick="window.app.newForm()" title="Novo Formulário (New Form)">
        📄
      </button>
      <button class="tool-btn" onclick="window.app.saveForm()" title="Salvar (Ctrl+S)">
        💾
      </button>
      <button class="tool-btn" onclick="window.app.saveForm()" title="Salvar Tudo (Save All)">
        📁💾
      </button>

      <div class="tool-sep"></div>

      <!-- Edição -->
      <button class="tool-btn" onclick="window.app.editCut()" title="Recortar Componente (Ctrl+X)">
        ✂️
      </button>
      <button class="tool-btn" onclick="window.app.editCopy()" title="Copiar Componente (Ctrl+C)">
        📄
      </button>
      <button class="tool-btn" onclick="window.app.editPaste()" title="Colar Componente (Ctrl+V)">
        📋
      </button>
      <button class="tool-btn" onclick="window.app.designer.duplicateSelected()" title="Duplicar Componente (Ctrl+D)">
        📑
      </button>
      <button class="tool-btn" onclick="window.app.designer.deleteSelected()" title="Excluir Componente (Del)">
        🗑️
      </button>

      <div class="tool-sep"></div>

      <!-- Execução e Depuração (Run / Debug Group Delphi) -->
      <button class="tool-btn btn-run-delphi" style="border-color: #22c55e; color: #4ade80;" onclick="window.app.startDebug()" title="Iniciar Depuração com Pontos de Parada (F9)">
        🐞 Debug (F9)
      </button>
      <button class="tool-btn" onclick="window.app.runApp()" title="Executar Sistema Web (Ctrl+F9)">
        ▶ Run
      </button>
      <button class="tool-btn" id="tbBtnStepOver" onclick="window.app.stepOver()" title="Passo a Passo / Step Over (F8)">
        ⤵ Step Over (F8)
      </button>
      <button class="tool-btn" id="tbBtnStepInto" onclick="window.app.stepInto()" title="Entrar na Função / Step Into (F7)">
        ⤷ Step Into (F7)
      </button>
      <button class="tool-btn" id="tbBtnPause" onclick="window.app.pauseDebug()" title="Pausar Depuração">
        ⏸
      </button>
      <button class="tool-btn" id="tbBtnStop" onclick="window.app.stopDebug()" title="Parar Depuração (Program Reset - Ctrl+F2)">
        ⏹
      </button>
      <button class="tool-btn" onclick="window.app.toggleBreakpointCurrentLine()" title="Alternar Ponto de Parada na Linha Atual (F5)" style="color: #ef4444; font-weight: 700;">
        🔴 BP (F5)
      </button>
      <button class="tool-btn" onclick="window.app.buildWebApp()" title="Compilar Sistema Web (dist/web-app/)">
        ⚙️ Build Web
      </button>

      <div class="tool-sep"></div>

      <!-- Botão GitHub Delphi -->
      <button class="tool-btn" onclick="window.app.openGitDialog('commit')" title="GitHub: Commit & Push (Ctrl+Shift+G)" style="border: 1px solid #7c3aed; color: #c084fc; background: rgba(124, 58, 237, 0.15); font-weight: 700; padding: 2px 10px; gap: 5px; display: inline-flex; align-items: center;">
        <span>🐙</span>
        <span>GitHub</span>
      </button>

      <div class="tool-sep"></div>

      <!-- Alvo / Plataforma -->
      <select class="platform-dropdown" style="width: 220px; color: #4cc2ff; font-weight: 600;">
        <option selected>🌐 Web Browser (HTML5 + REST)</option>
        <option>📱 Web Mobile / Responsive</option>
      </select>

      <select class="platform-dropdown" style="width: 80px;">
        <option selected>Debug</option>
        <option>Release</option>
      </select>
    </div>

    <!-- Lado Direito da Toolbar: Modelos Rápidos -->
    <div class="toolbar-group">
      <select id="toolbarTemplateSelect" class="platform-dropdown" onchange="if(this.value) window.app.loadExampleTemplate(this.value);" style="background:#232832; color:#00e5ff; font-weight:600;" title="Carregar Projeto Exemplo no Designer">
        <option value="" disabled selected>📂 Carregar Projeto Exemplo...</option>
        <option value="erpCompleto">🌟 ERP Completo MVC (Clientes NF-e, Produtos, Estoque, PDV)</option>
        <option value="crudClientes">📋 Cadastro de Clientes (Menu no Topo)</option>
        <option value="sistemaSidebar">📑 Sistema Comercial (Menu Lateral à Esquerda)</option>
        <option value="pdv">🛒 Frente de Caixa (PDV Comercial)</option>
        <option value="calculadora">🔢 Calculadora RAD</option>
        <option value="__custom_folder__">📁 Criar Projeto em Nova Pasta...</option>
      </select>
      <div class="tool-sep"></div>
      <button class="tool-btn" id="btnThemeToggle" onclick="window.app.toggleTheme()" title="Alternar Modo Claro / Escuro (Light / Dark)" style="padding: 0 10px; gap: 6px;">
        <span id="themeIcon">☀️</span> <span id="themeText" style="font-weight: 600;">Modo Claro</span>
      </button>
    </div>
  </div>

  <!-- ========================================================================
       3. WORKSPACE PRINCIPAL (3 COLUNAS: ESQUERDA, CENTRO, DIREITA)
       ======================================================================== -->
  <div class="delphi-workspace">

    <!-- ── COLUNA ESQUERDA: STRUCTURE & OBJECT INSPECTOR ─────────────────── -->
    <div class="left-dock-column" id="leftDockColumn">

      <!-- 1. Structure Panel -->
      <div class="dock-panel structure-panel" id="structurePanel">
        <div class="panel-header">
          <span>Structure</span>
          <div class="panel-header-actions">
            <span>📌</span>
            <span>✕</span>
          </div>
        </div>
        <div class="structure-toolbar">
          <span title="Expandir Todos" style="cursor:pointer;">▼</span>
          <span title="Recolher Todos" style="cursor:pointer;">▲</span>
          <span style="font-size:10px; color:#6c7889;">| Hierarquia do Form</span>
        </div>
        <div class="structure-tree" id="structureTree">
          <!-- Árvore preenchida dinamicamente -->
        </div>
      </div>

      <!-- Splitter Horizontal Delphi: Structure / Object Inspector -->
      <div class="dock-splitter dock-splitter-h" id="splitterStructureOI" title="Arrastar para esticar Structure e Object Inspector (Duplo clique para redefinir)">
        <div class="splitter-grip-h"></div>
      </div>

      <!-- 2. Object Inspector Panel -->
      <div class="dock-panel object-inspector-panel" id="objectInspectorPanel">
        <div class="panel-header">
          <span>Object Inspector</span>
          <div class="panel-header-actions">
            <span>📌</span>
            <span>✕</span>
          </div>
        </div>

        <!-- Seletor do Componente Atual -->
        <div class="oi-selector-container">
          <select class="oi-component-dropdown" id="oiComponentDropdown">
            <!-- Opções injetadas dinamicamente -->
          </select>
        </div>

        <!-- Busca de Propriedades -->
        <div class="oi-search-bar">
          <input type="text" class="oi-search-input" id="oiSearchInput" placeholder="🔍 Filtrar propriedades...">
        </div>

        <!-- Abas Properties / Events -->
        <div class="oi-tabs">
          <div class="oi-tab active" id="oiTabProperties">Properties</div>
          <div class="oi-tab" id="oiTabEvents">Events</div>
        </div>

        <!-- Conteúdo do Grid -->
        <div class="oi-grid-content">
          <div id="oiPropertiesContainer"></div>
          <div id="oiEventsContainer" style="display: none;"></div>
        </div>

        <!-- Links de Rodapé do Object Inspector -->
        <div class="oi-footer-links">
          <span onclick="window.app.toggleDesignCodeView()">View as Text (F12)</span>
          <span onclick="window.app.runApp()">Bind Visually...</span>
        </div>
      </div>

    </div>

    <!-- Splitter Vertical Delphi: Coluna Esquerda / Coluna Central -->
    <div class="dock-splitter dock-splitter-v" id="splitterLeftCenter" title="Arrastar para esticar largura de Structure e Object Inspector (Duplo clique para redefinir)">
      <div class="splitter-grip-v"></div>
    </div>

    <!-- ── COLUNA CENTRAL: FORM DESIGNER / CODE VIEW ──────────────────────── -->
    <div class="center-dock-column">

      <!-- Abas dos Documentos no Topo: Multi-Tabs Delphi Style -->
      <div class="document-tab-bar" id="documentTabBar">
        <div class="doc-tab active" data-tab-id="tab_default" onclick="window.app.switchTab('tab_default')">
          <div class="doc-tab-dot"></div>
          <span id="docTabTitle">Unit1.vox</span>
          <span class="doc-tab-close" onclick="event.stopPropagation(); window.app.closeTab('tab_default')">✕</span>
        </div>
      </div>

      <!-- Visão 1: Designer Visual Canvas -->
      <div class="delphi-designer-container" id="designerContainer">
        <!-- Janela do Formulário Delphi -->
        <div class="delphi-form-window" id="delphiFormWindow" style="width: 700px; height: 480px; min-width: 200px; min-height: 140px;">
          <div class="delphi-form-titlebar" id="formTitlebar">
            <div class="delphi-form-title">
              <span class="delphi-form-icon"></span>
              <span id="formTitleText">Form1</span>
            </div>
