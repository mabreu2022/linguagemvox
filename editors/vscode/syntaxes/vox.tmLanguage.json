{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vox",
  "scopeName": "source.vox",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#decorators" },
    { "include": "#macros" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#function_calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vox",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vox",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vox",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vox",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.vox",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.vox",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vox",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.vox",
          "match": "\\b(0x[0-9a-fA-F]+|0b[01]+|0o[0-7]+|[0-9]+)\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.vox",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "support.function.macro.vox",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*!"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vox",
          "match": "\\b(if|elif|else|while|for|in|match|return|break|continue|spawn|async|await)\\b"
        },
        {
          "name": "keyword.declaration.vox",
          "match": "\\b(class|interface|mixin|fn|let|const)\\b"
        },
        {
          "name": "storage.modifier.vox",
          "match": "\\b(pub|priv|prot|stat|new|self|super|own|borrow|ref|move)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.vox",
          "match": "\\b(int|float|str|bool|char|void)\\b"
        },
        {
          "name": "support.type.container.vox",
          "match": "\\b(Option|Result|Channel|Array|Map|Tuple)\\b"
        },
        {
          "name": "entity.name.type.class.vox",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.vox",
          "match": "\\b(print|println|eprint|len|panic|assert|sqrt|abs|floor|ceil|min|max|pow|rand|chan_new|chan_send|chan_recv|chan_close|some|none|ok|err)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.vox",
          "match": "\\b(true|false|null|none)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.vox",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.vox",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.vox",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.vox",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.vox",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.vox",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.vox",
          "match": "="
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.vox" }
          }
        }
      ]
    }
  }
}
