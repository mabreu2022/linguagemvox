{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vox",
  "scopeName": "source.vox",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#decorators" },
    { "include": "#macros" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#function_calls" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vox",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vox",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vox",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vox",
              "match": "\\\\."
            },
            {
              "name": "variable.interpolation.vox",
              "match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.vox",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.vox",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.vox",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.vox",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.vox",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.vox",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.vox",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.vox",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "support.function.macro.vox",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*!"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.type.vox",
          "match": "\\b(struct|trait|impl|enum|type)\\b"
        },
        {
          "name": "keyword.declaration.function.vox",
          "match": "\\b(fn)\\b"
        },
        {
          "name": "keyword.declaration.variable.vox",
          "match": "\\b(let|const)\\b"
        },
        {
          "name": "storage.modifier.mut.vox",
          "match": "\\b(mut)\\b"
        },
        {
          "name": "storage.modifier.ownership.vox",
          "match": "\\b(move|own|borrow|ref)\\b"
        },
        {
          "name": "storage.modifier.visibility.vox",
          "match": "\\b(pub|priv|prot|stat)\\b"
        },
        {
          "name": "keyword.control.concurrency.vox",
          "match": "\\b(spawn|async|await)\\b"
        },
        {
          "name": "keyword.control.flow.vox",
          "match": "\\b(if|elif|else|while|loop|for|in|match|return|break|continue)\\b"
        },
        {
          "name": "keyword.other.vox",
          "match": "\\b(use|mod|as|new)\\b"
        },
        {
          "name": "variable.language.self.vox",
          "match": "\\b(self|Self|super)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.vox",
          "match": "\\b(int|float|str|bool|char|void|any)\\b"
        },
        {
          "name": "support.type.container.vox",
          "match": "\\b(Option|Result|Channel|Array|Map|Tuple)\\b"
        },
        {
          "name": "entity.name.type.struct.vox",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.vox",
          "match": "\\b(print|println|eprint|len|panic|assert|sqrt|abs|floor|ceil|min|max|pow|rand|chan_new|chan_send|chan_recv|chan_close)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.vox",
          "match": "\\b(true|false|null|none|some|ok|err)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.null-coalescing.vox",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.optional-chaining.vox",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.scope.vox",
          "match": "::"
        },
        {
          "name": "keyword.operator.arrow.fat.vox",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arrow.thin.vox",
          "match": "->"
        },
        {
          "name": "keyword.operator.pipe.vox",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.vox",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.vox",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.vox",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.vox",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.vox",
          "match": "=|\\+=|-=|\\*=|/="
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.vox" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.name.vox",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
