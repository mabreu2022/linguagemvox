// ==============================================================================
// Vox Design Package (.vdpk) — Modelo de Pacote de Componentes para Vox RAD
// ==============================================================================
package VoxCustomControls;

requires
    vox_rtl,
    vox_vcl,
    vox_designer;

contains
    vox_RatingStars in 'vox_RatingStars.vox',
    vox_CustomBadge in 'vox_CustomBadge.vox';

// ------------------------------------------------------------------------------
// Definição do Componente: vox_RatingStars
// ------------------------------------------------------------------------------
classe vox_RatingStars herda vox_Panel {
    pub let mut StarsCount: i32;
    pub let mut Rating: f32;
    pub let mut ActiveColor: string;
    pub let mut InactiveColor: string;
    pub let mut ReadOnly: bool;

    procedimento Inicializar() {
        this.width = 140;
        this.height = 32;
        this.StarsCount = 5;
        this.Rating = 4.0;
        this.ActiveColor = "#ffca28";
        this.InactiveColor = "#4b5563";
        this.ReadOnly = false;
    }

    procedimento SetRating(novoValor: f32) {
        if novoValor >= 0.0 && novoValor <= f32(this.StarsCount) {
            this.Rating = novoValor;
            this.Invalidar();
        }
    }

    procedimento Renderizar() -> string {
        return "<div class='vcl-rating-stars' data-rating='" + str(this.Rating) + "'>⭐ ⭐ ⭐ ⭐ ☆</div>";
    }
}

// ------------------------------------------------------------------------------
// Procedimento Oficial de Registro no IDE Vox Studio (Equivalente ao Register do Delphi)
// ------------------------------------------------------------------------------
procedimento Register() {
    RegisterComponents("Custom", [
        vox_RatingStars,
        vox_CustomBadge
    ]);
}
