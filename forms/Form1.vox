        this.vox_Button6 = new TVoxButton();
        this.vox_Button6.left = 88;
        this.vox_Button6.top = 110;
        this.vox_Button6.width = 65;
        this.vox_Button6.height = 40;
        this.vox_Button6.caption = "5";

        this.vox_Button7 = new TVoxButton();
        this.vox_Button7.left = 160;
        this.vox_Button7.top = 110;
        this.vox_Button7.width = 65;
        this.vox_Button7.height = 40;
        this.vox_Button7.caption = "6";

        this.vox_Button8 = new TVoxButton();
        this.vox_Button8.left = 232;
        this.vox_Button8.top = 110;
        this.vox_Button8.width = 68;
        this.vox_Button8.height = 40;
