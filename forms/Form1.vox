        this.vox_Button9.top = 160;
        this.vox_Button9.width = 65;
        this.vox_Button9.height = 40;
        this.vox_Button9.caption = "1";

        this.vox_Button10 = new TVoxButton();
        this.vox_Button10.left = 88;
        this.vox_Button10.top = 160;
        this.vox_Button10.width = 65;
        this.vox_Button10.height = 40;
        this.vox_Button10.caption = "2";

        this.vox_Button11 = new TVoxButton();
        this.vox_Button11.left = 160;
        this.vox_Button11.top = 160;
        this.vox_Button11.width = 65;
        this.vox_Button11.height = 40;
        this.vox_Button11.caption = "3";

        this.vox_Button12 = new TVoxButton();
