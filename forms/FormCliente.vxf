{
  "name": "Form1",
  "title": "Form1",
  "width": 660,
  "height": 460,
  "components": [
    {
      "id": "comp_conn1",
      "name": "FDConnection1",
      "type": "TFDConnection",
      "left": 16,
      "top": 10,
      "width": 38,
      "height": 38,
      "props": {
        "DriverName": "SQLite",
        "Database": "clientes_vox.db",
        "Connected": true
      }
    },
    {
      "id": "comp_qry1",
      "name": "FDQuery1",
      "type": "TFDQuery",
      "left": 60,
      "top": 10,
      "width": 38,
      "height": 38,
      "props": {
        "Connection": "FDConnection1",
        "SQL": "SELECT id, nome, email, cidade, saldo FROM clientes",
        "Active": true
      }
    },
    {
      "id": "comp_ds1",
      "name": "DataSource1",
      "type": "TDataSource",
      "left": 104,
      "top": 10,
      "width": 38,
      "height": 38,
      "props": {
        "DataSet": "FDQuery1",
        "AutoEdit": true
      }
    },
    {
      "id": "comp_nav1",
      "name": "DBNavigator1",
      "type": "TDBNavigator",
      "left": 160,
      "top": 16,
      "width": 240,
      "height": 26,
      "props": {
        "DataSource": "DataSource1"
      }
    },
    {
      "id": "comp_gb1",
      "name": "GroupBox1",
      "type": "TGroupBox",
      "left": 16,
      "top": 56,
      "width": 625,
      "height": 135,
      "props": {
        "Caption": " Dados do Cliente "
      }
    },
    {
      "id": "comp_lbl_nome",
      "name": "Label1",
      "type": "TLabel",
      "left": 32,
      "top": 82,
      "width": 45,
      "height": 18,
      "props": {
        "Caption": "Nome:"
      }
    },
    {
      "id": "comp_edit_nome",
      "name": "DBEdit1",
      "type": "TDBEdit",
      "left": 80,
      "top": 78,
      "width": 240,
      "height": 24,
      "props": {
        "DataSource": "DataSource1",
        "DataField": "nome"
      }
    },
    {
      "id": "comp_lbl_email",
      "name": "Label2",
      "type": "TLabel",
      "left": 340,
      "top": 82,
      "width": 45,
      "height": 18,
      "props": {
        "Caption": "E-mail:"
      }
    },
    {
      "id": "comp_edit_email",
      "name": "DBEdit2",
      "type": "TDBEdit",
      "left": 390,
      "top": 78,
      "width": 235,
      "height": 24,
      "props": {
        "DataSource": "DataSource1",
        "DataField": "email"
      }
    },
    {
      "id": "comp_lbl_cidade",
      "name": "Label3",
      "type": "TLabel",
      "left": 32,
      "top": 120,
      "width": 45,
      "height": 18,
      "props": {
        "Caption": "Cidade:"
      }
    },
    {
      "id": "comp_edit_cidade",
      "name": "DBEdit3",
      "type": "TDBEdit",
      "left": 80,
      "top": 116,
      "width": 180,
      "height": 24,
      "props": {
        "DataSource": "DataSource1",
        "DataField": "cidade"
      }
    },
    {
      "id": "comp_lbl_saldo",
      "name": "Label4",
      "type": "TLabel",
      "left": 280,
      "top": 120,
      "width": 45,
      "height": 18,
      "props": {
        "Caption": "Saldo:"
      }
    },
    {
      "id": "comp_edit_saldo",
      "name": "DBEdit4",
      "type": "TDBEdit",
      "left": 325,
      "top": 116,
      "width": 120,
      "height": 24,
      "props": {
        "DataSource": "DataSource1",
        "DataField": "saldo"
      }
    },
    {
      "id": "comp_btn_salvar",
      "name": "Button1",
      "type": "TButton",
      "left": 535,
      "top": 115,
      "width": 90,
      "height": 26,
      "props": {
        "Caption": "Salvar"
      },
      "events": {
        "OnClick": "Button1Click"
      }
    },
    {
      "id": "comp_grid1",
      "name": "DBGrid1",
      "type": "TDBGrid",
      "left": 16,
      "top": 204,
      "width": 625,
      "height": 230,
      "props": {
        "DataSource": "DataSource1",
        "Columns": "ID, Nome, Cidade, Saldo"
      },
      "events": {
        "OnCellClick": "DBGrid1CellClick"
      }
    }
  ]
}