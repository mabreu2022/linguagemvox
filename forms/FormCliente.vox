// ==============================================================================
// Form1.vox — Classe de Formulário RAD Gerada pelo Vox Studio
// ==============================================================================

class Form1 {
    // ── Definições de Componentes Visuais ─────────────────────────────────────
    let mut width: int;
    let mut height: int;
    let mut title: str;
    let mut FDConnection1: TFDConnection;
    let mut FDQuery1: TFDQuery;
    let mut DataSource1: TDataSource;
    let mut DBNavigator1: TDBNavigator;
    let mut GroupBox1: TGroupBox;
    let mut Label1: TLabel;
    let mut DBEdit1: TDBEdit;
    let mut Label2: TLabel;
    let mut DBEdit2: TDBEdit;
    let mut Label3: TLabel;
    let mut DBEdit3: TDBEdit;
    let mut Label4: TLabel;
    let mut DBEdit4: TDBEdit;
    let mut Button1: TButton;
    let mut DBGrid1: TDBGrid;

    // ── Construtor e Inicialização de Tela ────────────────────────────────────
    new() {
        this.title = "Form1";
        this.width = 660;
        this.height = 460;

        this.FDConnection1 = new TFDConnection();
        this.FDConnection1.left = 16;
        this.FDConnection1.top = 10;
        this.FDConnection1.width = 38;
        this.FDConnection1.height = 38;
        this.FDConnection1.driverName = "SQLite";
        this.FDConnection1.database = "clientes_vox.db";
        this.FDConnection1.connected = true;

        this.FDQuery1 = new TFDQuery();
        this.FDQuery1.left = 60;
        this.FDQuery1.top = 10;
        this.FDQuery1.width = 38;
        this.FDQuery1.height = 38;
        this.FDQuery1.connection = "FDConnection1";
        this.FDQuery1.sql = "SELECT id, nome, email, cidade, saldo FROM clientes";
        this.FDQuery1.active = true;

        this.DataSource1 = new TDataSource();
        this.DataSource1.left = 104;
        this.DataSource1.top = 10;
        this.DataSource1.width = 38;
        this.DataSource1.height = 38;
        this.DataSource1.dataSet = "FDQuery1";

        this.DBNavigator1 = new TDBNavigator();
        this.DBNavigator1.left = 160;
        this.DBNavigator1.top = 16;
        this.DBNavigator1.width = 240;
        this.DBNavigator1.height = 26;
        this.DBNavigator1.dataSource = "DataSource1";

        this.GroupBox1 = new TGroupBox();
        this.GroupBox1.left = 16;
        this.GroupBox1.top = 56;
        this.GroupBox1.width = 625;
        this.GroupBox1.height = 135;
        this.GroupBox1.caption = " Dados do Cliente ";

        this.Label1 = new TLabel();
        this.Label1.left = 32;
        this.Label1.top = 82;
        this.Label1.width = 45;
        this.Label1.height = 18;
        this.Label1.caption = "Nome:";

        this.DBEdit1 = new TDBEdit();
        this.DBEdit1.left = 80;
        this.DBEdit1.top = 78;
        this.DBEdit1.width = 240;
        this.DBEdit1.height = 24;
        this.DBEdit1.dataSource = "DataSource1";
        this.DBEdit1.dataField = "nome";

        this.Label2 = new TLabel();
        this.Label2.left = 340;
        this.Label2.top = 82;
        this.Label2.width = 45;
        this.Label2.height = 18;
        this.Label2.caption = "E-mail:";

        this.DBEdit2 = new TDBEdit();
        this.DBEdit2.left = 390;
        this.DBEdit2.top = 78;
        this.DBEdit2.width = 235;
        this.DBEdit2.height = 24;
        this.DBEdit2.dataSource = "DataSource1";
        this.DBEdit2.dataField = "email";

        this.Label3 = new TLabel();
        this.Label3.left = 32;
        this.Label3.top = 120;
        this.Label3.width = 45;
        this.Label3.height = 18;
        this.Label3.caption = "Cidade:";

        this.DBEdit3 = new TDBEdit();
        this.DBEdit3.left = 80;
        this.DBEdit3.top = 116;
        this.DBEdit3.width = 180;
        this.DBEdit3.height = 24;
        this.DBEdit3.dataSource = "DataSource1";
        this.DBEdit3.dataField = "cidade";

        this.Label4 = new TLabel();
        this.Label4.left = 280;
        this.Label4.top = 120;
        this.Label4.width = 45;
        this.Label4.height = 18;
        this.Label4.caption = "Saldo:";

        this.DBEdit4 = new TDBEdit();
        this.DBEdit4.left = 325;
        this.DBEdit4.top = 116;
        this.DBEdit4.width = 120;
        this.DBEdit4.height = 24;
        this.DBEdit4.dataSource = "DataSource1";
        this.DBEdit4.dataField = "saldo";

        this.Button1 = new TButton();
        this.Button1.left = 535;
        this.Button1.top = 115;
        this.Button1.width = 90;
        this.Button1.height = 26;
        this.Button1.caption = "Salvar";
        this.Button1.onclick = this.Button1Click;

        this.DBGrid1 = new TDBGrid();
        this.DBGrid1.left = 16;
        this.DBGrid1.top = 204;
        this.DBGrid1.width = 625;
        this.DBGrid1.height = 230;
        this.DBGrid1.dataSource = "DataSource1";
        this.DBGrid1.oncellclick = this.DBGrid1CellClick;

        println("Formulário " + this.title + " inicializado no Vox Studio.");
    }

    // Tratador de Evento: Button1 -> OnClick
    pub fn Button1Click(sender: any) -> void {
        println("[VOX EVENT] Button1 -> OnClick acionado!");
    }

    // Tratador de Evento: DBGrid1 -> OnCellClick
    pub fn DBGrid1CellClick(sender: any) -> void {
        println("[VOX EVENT] DBGrid1 -> OnCellClick acionado!");
    }
}

// ── Ponto de Entrada para Execução Standalone ─────────────────────────────────
fn main() -> void {
    let app = new Form1();
    println("Janela ativa: " + app.title + " [" + str(app.width) + "x" + str(app.height) + "]");
}
